# ---------------------------------------------------------------------------
# Project-specific: edge-vla-control-budget-jetson
#
# This repository holds code, configs, and measurements ONLY.
# No model checkpoints, no datasets, no raw recordings -- ever.
# Keep those on the Jetson's NVMe or in shared team storage and reference
# them by path from a file in configs/.
# ---------------------------------------------------------------------------

# Model weights, checkpoints, and compiled engines
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.gguf
*.onnx
*.engine
*.plan
*.trt
*.tflite
checkpoints/
weights/
# Root-anchored: a `models/` or `data/` package under src/ is source code and
# must stay tracked. Downloaded artifacts live at the repo root or off-repo.
/models/
# TensorRT INT8 calibration caches
*.cache

# Hugging Face / torch download caches
.cache/huggingface/
hf_cache/
.torch/

# Datasets and demonstrations
/data/
datasets/
demonstrations/
episodes/
recordings/
