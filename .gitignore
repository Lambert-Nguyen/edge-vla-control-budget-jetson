*.usdz

# results/ is tracked, but only for machine-readable measurements.
# Ignore everything, then re-allow CSV/JSON and the directory marker.
results/**
!results/.gitkeep
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.jsonl
!results/**/*.md

# Local hardware config -- serial ports, servo offsets, and camera
# calibration are per-bench and must not be shared between machines.
hardware/local/
*.local.yaml
calibration_local/
